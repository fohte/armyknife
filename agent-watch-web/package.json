{
  "name": "agent-watch-web",
  "private": true,
  "packageManager": "pnpm@12.7.0",
  "type": "module",
  "imports": {
    "#*": {
      "types": [
        "./src/*.tsx",
        "./src/*.ts",
        "./src/*"
      ],
      "default": "./src/*"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "conc -m 1 pnpm:format:eslint pnpm:format:prettier",
    "test": "conc pnpm:test:type pnpm:test:unit",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "1.3.0",
    "@fohte/ui": "0.1.6",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "neverthrow": "8.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.21.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@fohte/eslint-config": "0.5.1",
    "@fohte/storybook-addon": "0.2.0",
    "@ninoseki/eslint-plugin-neverthrow": "0.3.2",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-themes": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "eslint-plugin-storybook": "10.6.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "knip": "6.38.0",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.3",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
