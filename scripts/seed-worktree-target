#!/usr/bin/env bash

set -euo pipefail

if [ "$(uname -s)" != "Darwin" ]; then
  exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
WORKTREE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
TARGET_ROOT="$WORKTREE_ROOT/target"
TARGET_DEBUG="$TARGET_ROOT/debug"
STAGING_ROOT=""
TARGET_INSTALLED=0
SEED_COMPLETE=0

cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM

  if [ "$TARGET_INSTALLED" -eq 1 ] && [ "$SEED_COMPLETE" -eq 0 ]; then
    if [ -e "$TARGET_DEBUG" ] || [ -L "$TARGET_DEBUG" ]; then
      find "$TARGET_DEBUG" -depth -delete || true
    fi
  fi

  if [ -n "$STAGING_ROOT" ] && [ -e "$STAGING_ROOT" ]; then
    find "$STAGING_ROOT" -depth -delete || true
  fi

  exit "$status"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if [ -e "$TARGET_DEBUG" ] || [ -L "$TARGET_DEBUG" ]; then
  exit 0
fi

if ! WORKTREES="$(git -C "$WORKTREE_ROOT" worktree list --porcelain)"; then
  printf 'Could not list Git worktrees; skipping Cargo target seed.\n' >&2
  exit 1
fi

NEWEST_SOURCE_ROOT=""
NEWEST_SOURCE_MTIME=0

while IFS= read -r line; do
  case "$line" in
    'worktree '*)
      SOURCE_ROOT="${line#worktree }"
      SOURCE_BINARY="$SOURCE_ROOT/target/debug/a"
      if [ "$SOURCE_ROOT" = "$WORKTREE_ROOT" ] || [ ! -f "$SOURCE_BINARY" ]; then
        continue
      fi

      if ! SOURCE_MTIME="$(/usr/bin/stat -f '%m' "$SOURCE_BINARY")"; then
        printf 'Could not inspect %s; skipping Cargo target seed.\n' "$SOURCE_BINARY" >&2
        exit 1
      fi

      if ((SOURCE_MTIME > NEWEST_SOURCE_MTIME)); then
        NEWEST_SOURCE_ROOT="$SOURCE_ROOT"
        NEWEST_SOURCE_MTIME="$SOURCE_MTIME"
      fi
      ;;
  esac
done <<< "$WORKTREES"

if [ -z "$NEWEST_SOURCE_ROOT" ]; then
  exit 0
fi

SOURCE_DEBUG="$NEWEST_SOURCE_ROOT/target/debug"
TARGET_VOLUME_PATH="$TARGET_ROOT"
if [ ! -d "$TARGET_VOLUME_PATH" ]; then
  TARGET_VOLUME_PATH="$WORKTREE_ROOT"
fi

if ! SOURCE_DEVICE_ID="$(/usr/bin/stat -f '%d' "$SOURCE_DEBUG")" ||
  ! TARGET_DEVICE_ID="$(/usr/bin/stat -f '%d' "$TARGET_VOLUME_PATH")"; then
  printf 'Could not inspect clone source and target filesystems; skipping Cargo target seed.\n' >&2
  exit 1
fi

if [ "$SOURCE_DEVICE_ID" != "$TARGET_DEVICE_ID" ]; then
  printf 'Clone source and target are not on the same APFS volume; skipping Cargo target seed.\n' >&2
  exit 0
fi

# cp -c silently falls back to a full copy across volumes or on non-APFS filesystems.
if ! SOURCE_DEVICE="$(df -P "$SOURCE_DEBUG" | awk 'NR == 2 { print $1 }')" ||
  [ -z "$SOURCE_DEVICE" ] ||
  ! SOURCE_FILESYSTEM="$(mount | awk -v device="$SOURCE_DEVICE" '$1 == device { sub(/^.*[(]/, ""); sub(/,.*/, ""); print; exit }')"; then
  printf 'Could not identify the clone source filesystem; skipping Cargo target seed.\n' >&2
  exit 1
fi

if [ "$SOURCE_FILESYSTEM" != "apfs" ]; then
  printf 'Clone source is not on APFS; skipping Cargo target seed.\n' >&2
  exit 0
fi

if ! mkdir -p "$TARGET_ROOT"; then
  printf 'Could not create %s; skipping Cargo target seed.\n' "$TARGET_ROOT" >&2
  exit 1
fi

if ! STAGING_ROOT="$(mktemp -d "$TARGET_ROOT/.debug-seed.XXXXXX")"; then
  printf 'Could not create a staging directory in %s; skipping Cargo target seed.\n' "$TARGET_ROOT" >&2
  exit 1
fi

if ! /bin/cp -c -pR "$SOURCE_DEBUG" "$STAGING_ROOT/debug"; then
  printf 'Could not APFS-clone %s/target/debug; skipping Cargo target seed.\n' "$NEWEST_SOURCE_ROOT" >&2
  exit 1
fi

if [ -e "$TARGET_DEBUG" ] || [ -L "$TARGET_DEBUG" ]; then
  exit 0
fi

TARGET_INSTALLED=1
if ! mv "$STAGING_ROOT/debug" "$TARGET_DEBUG"; then
  TARGET_INSTALLED=0
  printf 'Could not install the seeded Cargo target at %s; skipping Cargo target seed.\n' "$TARGET_DEBUG" >&2
  exit 1
fi

# Clean from its final location so Cargo records the same target path used by later builds.
if ! (cd "$WORKTREE_ROOT" && CARGO_TARGET_DIR="$TARGET_ROOT" cargo clean --workspace); then
  printf 'Could not remove cloned workspace outputs; skipping Cargo target seed.\n' >&2
  exit 1
fi

SEED_COMPLETE=1
